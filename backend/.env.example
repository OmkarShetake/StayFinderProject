# ── Database ─────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stayfinder_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=stayfinder-super-secret-jwt-key-256-bits-long-change-in-prod

# ── Mail ──────────────────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENABLED=false
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=StayFinder

# ── Google Gemini AI ──────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_ENABLED=true

# ── Kafka ─────────────────────────────────────────────────────────────
# localhost:29092  → local dev  (Kafka exposed on host via docker-compose)
# kafka:9092       → Docker     (set this in docker-compose environment block)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
